# Sightline Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit real keys or secrets to version control.

# Server-side Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_placeholder"

# Secret token required by the /api/cron/run-due automated endpoint
CRON_SECRET="your_long_random_cron_secret_placeholder"

# Base URL where this application is hosted
APP_URL="http://localhost:3000"

# Server Port (optional, defaults to 3000)
PORT=3000
